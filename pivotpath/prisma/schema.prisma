// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          UserProfile?
  roadmap          Roadmap?
  transitionStory  TransitionStory?
  financialProfile FinancialProfile?
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: Your Profile
  currentJobTitle      String?
  topSkills            Json?
  financialConcernType String?
  industriesOfInterest Json?

  // Step 2: Career Goal
  targetRole           String?
  stillDecidingRole    Boolean @default(false)
  transitionMotivation String?

  // Step 3: Background & Timeline
  yearsExperience      String?
  educationLevel       String?
  weeklyTimeCommitment String?
  timelineUrgency      String?

  // Wizard progress: the highest step this account may access (1-4),
  // and when the whole questionnaire was completed.
  onboardingStep        Int       @default(1)
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One roadmap per account — generated once from the completed UserProfile.
model Roadmap {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole  String
  generatedAt DateTime @default(now())

  // Set when the user declares their transition complete — the gate for
  // publishing a TransitionStory. Nullable: most roadmaps are still in progress.
  transitionCompletedAt DateTime?

  milestones Milestone[]
}

model Milestone {
  id        String  @id @default(cuid())
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id])

  title       String
  description String
  order       Int

  // todo | in_progress | done
  status      String    @default("todo")
  completedAt DateTime?
}

// One published story per account — the "become a mentor" artifact.
// Fake/demo rows use a fake "seed-" prefixed userId that no real account
// will ever match, so they don't collide with the User relation.
model TransitionStory {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  photoUrl    String?
  fromRole    String
  toRole      String
  industry    String
  stepsTaken  String
  tips        String

  isPublished   Boolean   @default(true)
  publishedAt   DateTime  @default(now())
  unpublishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One per account — self-reported numbers only, never linked accounts or
// payment info. The Financial Plan (runway, tips) is computed live from
// these fields rather than stored, so it's never stale.
model FinancialProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlyIncomeDuringTransition Float
  essentialMonthlyExpenses      Float
  currentSavings                Float
  financialConcernType          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
