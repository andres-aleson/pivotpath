# Copy this to .env for local development, and set the same keys in your
# Vercel project's Environment Variables for deployment.

# Local dev: a plain file works out of the box, e.g. "file:./dev.db"
# Production (Vercel): a Turso database URL, e.g. "libsql://<db-name>-<org>.turso.io"
DATABASE_URL="file:./dev.db"

# Only needed when DATABASE_URL points at a hosted Turso database (i.e. in production).
# Leave unset for local file-based development.
TURSO_AUTH_TOKEN=""

# Session signing secret. Generate one with: openssl rand -base64 33
AUTH_SECRET=""

# Free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
