# Copy this to .env for local development, and set the same keys in your
# Vercel project's Environment Variables for deployment.

# Postgres connection string. The `schema` query param scopes all tables to
# the "pivotpath" schema on the shared database instead of "public".
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=pivotpath&sslmode=require"

# Optional: live job listings on the Job Openings tab. Free keys from
# https://developer.adzuna.com/ — without them the tab shows job-board search links instead.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
